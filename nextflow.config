// ============================================================================
// kge-mageck2-nextflow — UMI-aware CRISPR KO Screen Analysis Pipeline
// Demultiplexing → MAGeCK2 count/test/MLE → Interactive HTML Report
// ============================================================================

manifest {
    name            = 'kge-mageck2'
    author          = 'Mubasher Mohammed'
    description     = 'UMI-aware CRISPR KO screen analysis: flowcell demultiplexing → MAGeCK2 (KGE) → interactive HTML report'
    version         = '1.0.0'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04'
    homePage        = 'https://github.com/MubasherMohammed/KGE-Mageck2-nextflow'
}

// ---------------------------------------------------------------------------
// Default parameters
// ---------------------------------------------------------------------------
params {

    // -- Input: demultiplexing (BCL → FASTQ) --------------------------------
    run_folder              = ''                // Illumina run folder (BCL dir)
    sample_sheet            = ''                // SampleSheet.csv path
    demultiplex             = false             // Set true to start from BCL
    bcl_converter           = 'bcl-convert'     // 'bcl-convert' or 'bcl2fastq'

    // -- Input: direct FASTQ (skip demux) ------------------------------------
    fastq_dir               = ''                // Directory containing FASTQ files
    fastq_pattern           = '*_R1_*{fastq,fastq.gz,fq,fq.gz}'   // First read pair (guide reads)
    fastq_pattern_2         = '*_R2_*{fastq,fastq.gz,fq,fq.gz}'   // Second read pair (UMI reads); no match → single-end

    // -- Input: pre-computed count table (skip demux + count) ----------------
    count_table             = ''                // Path to existing .count.txt (skip counting)

    // -- Library & sample metadata -------------------------------------------
    library_file            = ''                // sgRNA library file (required for FASTQ mode); delimiter: comma for .csv, tab otherwise (mageck2 convention)
    sample_labels           = ''                // Comma-separated sample labels

    // -- Analysis input files ------------------------------------------------
    // Provide --comparisons for RRA, --design_matrix for MLE, or both.
    // The pipeline auto-detects: comparisons → RRA, design_matrix → MLE, both → RRA+MLE.
    comparisons             = ''                // TSV file: treatment<TAB>control (one pair per row)
    design_matrix           = ''                // Design matrix file (required for MLE)

    // -- MAGeCK count options ------------------------------------------------
    norm_method              = 'median'          // 'none', 'median', 'total', 'control'
    control_sgrna            = ''                // Control sgRNA file
    control_gene             = ''                // Control gene file
    sgrna_len                = 20                // sgRNA length
    trim5                    = 'AUTO'            // 5' trim length or 'AUTO'
    count_n                  = false             // Count sgRNAs with Ns
    reverse_complement       = false             // Reverse complement library

    // -- MAGeCK2 UMI options (count unique molecules, not raw reads) ---------
    // Offsets are 0-based: --umi_start/--umi_end are relative to the guide in
    // R1; --umi_start_2/--umi_end_2 count from the first base of R2.
    // Typical 10 bp UMI in R2: --umi secondpair --umi_start_2 0 --umi_end_2 10
    umi                      = 'none'            // 'none','firstpair','secondpair','auto'
    umi_start                = -1                // UMI window in R1 (offset from guide)
    umi_end                  = -1
    umi_start_2              = -1                // UMI window in R2 (from read start)
    umi_end_2                = -1

    // -- MAGeCK test (RRA) options -------------------------------------------
    adjust_method            = 'fdr'             // 'fdr', 'holm', 'pounds'
    gene_test_fdr_threshold  = 0.25
    remove_zero              = 'both'            // 'none','control','treatment','both','any'
    gene_lfc_method          = 'median'          // 'median','mean','alphamedian','alphamean','secondbest'

    // -- MAGeCK MLE options --------------------------------------------------
    include_samples          = ''                // Comma-separated sample labels for MLE
    beta_labels              = ''                // Comma-separated beta labels
    threads                   = 1                 // Threads for MLE
    permutation_round        = 2                 // Permutation rounds for MLE

    // -- HTML report options --------------------------------------------------
    html_report              = true              // Generate HTML report
    skip_enrichment          = false             // Skip pathway enrichment
    enrichment_top_n         = 50                // Top genes for enrichment
    enrichment_fdr           = 0.05              // FDR for enrichment significance
    organism                 = 'human'           // 'human' or 'mouse'
    fdr_threshold            = 0.05              // FDR threshold for plots
    top_n                    = 20                // Top genes to label

    // -- QC -------------------------------------------------------------------
    fastqc                   = true              // Run FastQC
    multiqc                  = true              // Run MultiQC

    // -- Output ---------------------------------------------------------------
    output_dir               = './results'
    output_prefix            = 'mageck2'

    // -- Container images (Docker/Singularity) --------------------------------
    containers {
        bcl_convert     = 'quay.io/biocontainers/bcl-convert:4.0.3--h57d0181_0'
        fastqc          = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
        multiqc         = 'quay.io/biocontainers/multiqc:1.25.1--pyh7e72e4a_0'
        mageck2         = 'mobasherbarsi/mageck2-kge:0.4.0'
    }
}

// ---------------------------------------------------------------------------
// Process defaults
// ---------------------------------------------------------------------------
process {
    cpus   = 1
    memory = '8.GB'
    time   = '24.h'

    withName: 'DEMULTIPLEX' {
        cpus   = 8
        memory = '32.GB'
        time   = '48.h'
    }
    withName: 'FASTQC_READS' {
        cpus   = 2
        memory = '4.GB'
    }
    withName: 'MAGECK_COUNT' {
        cpus   = 4
        memory = '16.GB'
        time   = '24.h'
    }
    withName: 'MAGECK_TEST_RRA' {
        cpus   = 4
        memory = '16.GB'
    }
    withName: 'MAGECK_MLE_ANALYSIS' {
        cpus   = params.threads
        memory = '16.GB'
    }
    withName: 'KGE_REPORT' {
        cpus   = 2
        memory = '8.GB'
    }
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------

profiles {

// Local execution with conda
    // IMPORTANT: mageck2 is pip-installed from a pinned git commit (see
    // environment.yml) and the KGE HTML-report + UMI-figure overlay (./mageck2/)
    // is applied by install.sh — it is NOT part of the pip install.
    //
    // Option A: Use the env created by install.sh (recommended for local
    //   runs — has mageck2 + KGE overlay, so --html-report works):
    //   bash install.sh                              # creates mageckenv2
    //   nextflow run . -profile conda \
    //     -process.conda=$HOME/miniconda3/envs/mageckenv2 \
    //     --fastq_dir ... --comparisons ...
    //
    // Option B: Use environment.yml (Nextflow creates the env automatically,
    //   including pip mageck2, but WITHOUT the KGE overlay — --html-report
    //   will fail; run install.sh and use Option A for HTML reports).
    //
    // For fully portable execution, use -profile docker or -profile singularity
    // (the mageck2-kge image has the overlay baked in).
    conda {
        process.executor = 'local'
        conda.enabled = true
        process {
            withName: 'DEMULTIPLEX'         { conda = "${projectDir}/environment.yml" }
            withName: 'FASTQC_READS'        { conda = "${projectDir}/environment.yml" }
            withName: 'MULTIQC_REPORT'       { conda = "${projectDir}/environment.yml" }
            withName: 'MAGECK_COUNT'        { conda = "${projectDir}/environment.yml" }
            withName: 'MAGECK_TEST_RRA'     { conda = "${projectDir}/environment.yml" }
            withName: 'MAGECK_MLE_ANALYSIS' { conda = "${projectDir}/environment.yml" }
            withName: 'KGE_REPORT'           { conda = "${projectDir}/environment.yml" }
        }
        params.fastqc = true
    }

    // Docker (local or HPC with Docker)
    docker {
        docker.enabled = true
        process {
            withName: 'DEMULTIPLEX'         { container = params.containers.bcl_convert }
            withName: 'FASTQC_READS'        { container = params.containers.fastqc }
            withName: 'MULTIQC_REPORT'       { container = params.containers.multiqc }
            withName: 'MAGECK_COUNT'         { container = params.containers.mageck2 }
            withName: 'MAGECK_TEST_RRA'     { container = params.containers.mageck2 }
            withName: 'MAGECK_MLE_ANALYSIS' { container = params.containers.mageck2 }
            withName: 'KGE_REPORT'           { container = params.containers.mageck2 }
        }
    }

    // Singularity (HPC clusters)
    singularity {
        singularity.enabled = true
        process {
            withName: 'DEMULTIPLEX'         { container = params.containers.bcl_convert }
            withName: 'FASTQC_READS'        { container = params.containers.fastqc }
            withName: 'MULTIQC_REPORT'       { container = params.containers.multiqc }
            withName: 'MAGECK_COUNT'         { container = params.containers.mageck2 }
            withName: 'MAGECK_TEST_RRA'     { container = params.containers.mageck2 }
            withName: 'MAGECK_MLE_ANALYSIS' { container = params.containers.mageck2 }
            withName: 'KGE_REPORT'           { container = params.containers.mageck2 }
        }
    }

    // SLURM (HPC cluster)
    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
        process.time     = '48.h'
    }

    // Dardel (PDC/KTH) — uses module system
    // Before running, load modules and activate the conda environment:
    //   ml PDC/23.12
    //   ml bioinfo-tools
    //   ml java/11
    //   ml miniconda3/25.3.1-1-cpeGNU-24.11
    //   ml nextflow/24.04.2
    //   ml singularity/4.1.1-cpeGNU-23.12
    //   source activate mageckenv
    //   nextflow run main.nf -profile dardel ...
    dardel {
        process.executor = 'local'
        params.fastqc = true
    }
}

// ---------------------------------------------------------------------------
// Execution log & report
// ---------------------------------------------------------------------------
timeline {
    enabled   = true
    file      = 'timeline.html'
    overwrite = true
}

trace {
    enabled   = true
    file      = 'trace.txt'
    overwrite = true
}

report {
    enabled   = true
    file      = 'report.html'
    overwrite = true
}

dag {
    enabled   = true
    file      = 'dag.svg'
    overwrite = true
}